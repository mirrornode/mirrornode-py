# MIRRORNODE :: Bridge Configuration Template (check 5.1)
# Copy to .env and populate with real secrets
# NEVER commit .env to git

# --- Node Identity ---
MIRRORNODE_NODE_ID=hermes-v0.2.0
MIRRORNODE_ENV=local

# --- Crypto / Vault ---
ORACLE_KEY_PATH=~/.mirrornode/oracle/keys/mirrornode_node.pem

# --- Lattice Node Endpoints ---
NUMERAETHE_ENDPOINT=http://localhost:8001
MERLIN_ENDPOINT=http://localhost:8002
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
TRISM_ENDPOINT=http://localhost:8005

# --- FastAPI ---
HOST=0.0.0.0
PORT=8000

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=~/.mirrornode/oracle/logs
